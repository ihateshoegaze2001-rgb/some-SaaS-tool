# Copy this file to .env and fill in ONE of the two keys below.
# Leave the other line blank (or delete it).

# Free, no card, good for testing:
GROQ_API_KEY=

# The real thing, for when you're ready to launch:
ANTHROPIC_API_KEY=

# Optional: force which provider is used. If left blank, the server uses
# Groq when a GROQ_API_KEY is present, otherwise Anthropic.
LLM_PROVIDER=

# Optional: change the local port (defaults to 3000).
PORT=
